{:deps {cljsjs/highlight                      {:mvn/version "11.7.0-0"}
        cljsjs/js-joda-timezone               {:mvn/version "2.2.0-0"}
        cljsjs/react                          {:mvn/version "18.3.1-1"}
        cljsjs/react-dom                      {:mvn/version "18.3.1-1"}
        org.clojure/clojure                   {:mvn/version "1.12.3"}
        org.clojure/clojurescript             {:mvn/version "1.12.42"}
        henryw374/js-joda                     {:mvn/version "3.2.0-0"}
        henryw374/js-joda-locale-en-us        {:mvn/version "1.0.0-1"}
        markdown-to-hiccup/markdown-to-hiccup {:mvn/version "0.6.2"}
        metosin/malli                         {:mvn/version "0.19.2"}
        metosin/muuntaja                      {:mvn/version "0.6.11"}
        metosin/reitit                        {:mvn/version "0.9.1"}
        re-frame/re-frame                     {:mvn/version "1.4.3"}
        reagent/reagent                       {:mvn/version "1.3.0"}
        sg.flybot/lasagna-pull                {:mvn/version "0.4.162"}
        tick/tick                             {:mvn/version "1.0"}
        markdown-clj/markdown-clj             {:mvn/version "1.12.4"}
        clj-rss/clj-rss                       {:mvn/version "0.4.0"}
        com.bhauman/figwheel-main             {:mvn/version "0.2.20"}
        day8.re-frame/test                    {:mvn/version "0.1.7"}}
 :paths ["src" "resources" "target" "test"]
 :aliases
 {;; Run clj tests
  :server/test {:extra-paths ["test"]
                :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                              lambdaisland/kaocha-cloverage {:mvn/version "1.1.89"}}
                :main-opts   ["-m" "kaocha.runner"]}

  ;;---------- WEB ----------
  ;; cljs repl for figwheel hot reloading development/testing
  ;; be sure to not have a main.js in resources/public
  :dev {:extra-deps {cider/cider-nrepl {:mvn/version "0.57.0"}
                     cider/piggieback  {:mvn/version "0.6.1"}}}

  ;; build the optimised js bundle
  :prod {:main-opts ["--main"       "figwheel.main"
                     "--build-once" "prod"]}

  ;; Run the cljs tests
  :test {:extra-deps {}
         :main-opts ["-m" "figwheel.main"
                     "-m" "loicb.client.test-runner"]}

  ;; Run the cljs tests with chrome headless
  :test-headless {:main-opts ["-m" "figwheel.main"
                              "-co" "tests.cljs.edn"
                              "-m" "loicb.client.test-runner"]}
  ;; RSS
  :rss {:main-opts ["-m" "loicb.build.rss"]}

  ;;---------- BUILD ----------
  :build {:deps       {io.github.clojure/tools.build {:git/tag "v0.10.10" :git/sha "deedd62"}}
          :ns-default build}

  :cljfmt {:deps       {io.github.weavejester/cljfmt {:git/tag "0.13.4" :git/sha "d56ac42"}}
           :ns-default cljfmt.tool}

  :outdated {;; Note that it is `:deps`, not `:extra-deps`
             :deps {com.github.liquidz/antq {:mvn/version "RELEASE"}}
             :main-opts ["-m" "antq.core"]}}}
